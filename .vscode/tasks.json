{
	"version": "2.0.0",
	"inputs": [
		{
			"id": "commitMessage",
			"type": "promptString",
			"description": "Commit message",
			"default": "chore: updates"
		}
	],
	"tasks": [

		// ─────────────────────────────────────────────────────────────
		// WEB — Next.js (apps/web, pnpm workspace)
		// ─────────────────────────────────────────────────────────────

		{
			"label": "Web: Dev Server",
			"type": "shell",
			"command": "pnpm --filter web dev",
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": {
				"pattern": { "regexp": "." },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Starting Next.js",
					"endsPattern": "Ready in|Local:.*3000"
				}
			},
			"presentation": { "group": "web", "reveal": "always", "panel": "dedicated" }
		},
		{
			"label": "Web: Build",
			"type": "shell",
			"command": "pnpm --filter web build",
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"presentation": { "group": "web", "reveal": "always" }
		},
		{
			"label": "Web: Test (vitest)",
			"type": "shell",
			"command": "pnpm --filter web test --run",
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"presentation": { "group": "web", "reveal": "always" }
		},
		{
			"label": "Web: Lint (ESLint)",
			"type": "shell",
			"command": "pnpm --filter web lint",
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": ["$eslint-stylish"],
			"presentation": { "group": "web", "reveal": "always" }
		},
		{
			"label": "Web: Typecheck",
			"type": "shell",
			"command": "pnpm --filter web typecheck",
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": ["$tsc"],
			"presentation": { "group": "web", "reveal": "always" }
		},
		{
			"label": "Web: Storybook",
			"type": "shell",
			"command": "pnpm --filter web storybook",
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": {
				"pattern": { "regexp": "." },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Starting Storybook",
					"endsPattern": "Storybook.*started|Local:.*6006"
				}
			},
			"presentation": { "group": "web", "reveal": "always", "panel": "dedicated" }
		},
		{
			"label": "Web: Brand Guard",
			"type": "shell",
			"command": "pnpm --filter web brand-guard",
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"presentation": { "group": "web", "reveal": "always" }
		},
		{
			"label": "Web: Dependency Cruiser",
			"type": "shell",
			"command": "pnpm --filter web depcruise",
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"presentation": { "group": "web", "reveal": "always" }
		},

		// ─────────────────────────────────────────────────────────────
		// COMMERCE API — FastAPI (apps/commerce-api, uv workspace)
		// ─────────────────────────────────────────────────────────────

		{
			"label": "Commerce API: Dev Server",
			"type": "shell",
			"command": "uv run uvicorn yasargold_commerce.main:app --reload --port 8000",
			"options": { "cwd": "${workspaceFolder}/apps/commerce-api" },
			"isBackground": true,
			"problemMatcher": {
				"pattern": { "regexp": "." },
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Started|Uvicorn running",
					"endsPattern": "Application startup complete"
				}
			},
			"presentation": { "group": "commerce", "reveal": "always", "panel": "dedicated" }
		},
		{
			"label": "Commerce API: Test",
			"type": "shell",
			"command": "uv run pytest tests/ -q",
			"options": { "cwd": "${workspaceFolder}/apps/commerce-api" },
			"problemMatcher": [],
			"presentation": { "group": "commerce", "reveal": "always" }
		},
		{
			"label": "Commerce API: Import Linter",
			"type": "shell",
			"command": "uv run lint-imports",
			"options": { "cwd": "${workspaceFolder}/apps/commerce-api" },
			"problemMatcher": [],
			"presentation": { "group": "commerce", "reveal": "always" }
		},
		{
			"label": "Domain: Test (packages/domain)",
			"type": "shell",
			"command": "uv run pytest packages/domain/tests/ -q",
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"presentation": { "group": "commerce", "reveal": "always" }
		},

		// ─────────────────────────────────────────────────────────────
		// BACKEND — Flask ERP (backend/, venv)
		// ─────────────────────────────────────────────────────────────

		{
			"label": "Backend: Start",
			"type": "shell",
			"command": "export DATABASE_URL=\"sqlite:///${workspaceFolder}/app.db\"; PORT=8001; pids=\"$(lsof -ti tcp:${PORT} 2>/dev/null || true)\"; if [ -n \"${pids}\" ]; then echo \"Killing port ${PORT}...\"; echo \"${pids}\" | xargs kill -TERM 2>/dev/null || true; sleep 0.5; pids=\"$(lsof -ti tcp:${PORT} 2>/dev/null || true)\"; if [ -n \"${pids}\" ]; then echo \"${pids}\" | xargs kill -KILL 2>/dev/null || true; fi; for i in $(seq 1 30); do sleep 0.2; pids=\"$(lsof -ti tcp:${PORT} 2>/dev/null || true)\"; [ -z \"${pids}\" ] && break; done; fi; echo \"Starting backend on :${PORT}...\"; if [ -x \"./venv/bin/gunicorn\" ]; then ./venv/bin/gunicorn -b 0.0.0.0:${PORT} --workers 1 --threads 4 --timeout 120 app:app; elif [ -x \"./venv/bin/python\" ]; then ./venv/bin/python app.py; else python3 app.py; fi",
			"options": { "cwd": "${workspaceFolder}/backend" },
			"isBackground": true,
			"problemMatcher": [],
			"presentation": { "group": "backend", "reveal": "always", "panel": "dedicated" }
		},
		{
			"label": "Backend: Start (foreground / reload)",
			"type": "shell",
			"command": "export DATABASE_URL=\"sqlite:///${workspaceFolder}/app.db\"; PORT=8001; pids=\"$(lsof -ti tcp:${PORT} 2>/dev/null || true)\"; if [ -n \"${pids}\" ]; then echo \"Killing port ${PORT}...\"; echo \"${pids}\" | xargs kill -KILL 2>/dev/null || true; sleep 1; fi; echo \"Starting backend (--reload) on :${PORT}...\"; if [ -x \"./venv/bin/gunicorn\" ]; then ./venv/bin/gunicorn --reload -b 0.0.0.0:${PORT} --workers 1 --threads 4 --timeout 120 app:app; elif [ -x \"./venv/bin/python\" ]; then ./venv/bin/python app.py; else python3 app.py; fi",
			"options": { "cwd": "${workspaceFolder}/backend" },
			"isBackground": false,
			"problemMatcher": [],
			"presentation": { "group": "backend", "reveal": "always", "panel": "dedicated" }
		},
		{
			"label": "Backend: Pytest",
			"type": "shell",
			"command": "( [ -x \"./venv/bin/python\" ] && ./venv/bin/python -m pytest -q || python3 -m pytest -q )",
			"options": { "cwd": "${workspaceFolder}/backend" },
			"problemMatcher": [],
			"presentation": { "group": "backend", "reveal": "always" }
		},

		// ─────────────────────────────────────────────────────────────
		// FULL STACK — start all three services
		// ─────────────────────────────────────────────────────────────

		{
			"label": "Dev: Start All",
			"dependsOn": [
				"Backend: Start",
				"Commerce API: Dev Server",
				"Web: Dev Server"
			],
			"dependsOrder": "parallel",
			"problemMatcher": []
		},

		// ─────────────────────────────────────────────────────────────
		// DOCKER
		// ─────────────────────────────────────────────────────────────

		{
			"label": "Docker: Build Backend Image",
			"type": "shell",
			"command": "docker build -t yasargold-backend:dev -f backend/Dockerfile .",
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": []
		},
		{
			"label": "Docker: Compose Up (prod)",
			"type": "shell",
			"command": "docker compose -f docker-compose.prod.yml up --build",
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": []
		},

		// ─────────────────────────────────────────────────────────────
		// GIT
		// ─────────────────────────────────────────────────────────────

		{
			"label": "Git: Commit & Push",
			"type": "shell",
			"command": "bash _safe_commit.sh \"${input:commitMessage}\"",
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": []
		},

		// ─────────────────────────────────────────────────────────────
		// DEBUG UTILITIES (essential only)
		// ─────────────────────────────────────────────────────────────

		{
			"label": "Debug: Backend Health",
			"type": "shell",
			"command": "curl -s http://127.0.0.1:8001/api/debug/db-info | python3 -c 'import sys,json; print(json.dumps(json.load(sys.stdin), ensure_ascii=False, indent=2))'",
			"problemMatcher": []
		},
		{
			"label": "Debug: Gold Price",
			"type": "shell",
			"command": "curl -s http://127.0.0.1:8001/api/public/gold_price | python3 -c 'import sys,json; d=json.load(sys.stdin); print(\"24K:\",d.get(\"price_24k\"),\"21K:\",d.get(\"price_21k\"),\"source:\",d.get(\"source\"))'",
			"problemMatcher": []
		},
		{
			"label": "Debug: Commerce API Health",
			"type": "shell",
			"command": "curl -s http://127.0.0.1:8000/health | python3 -c 'import sys,json; print(json.dumps(json.load(sys.stdin), indent=2))'",
			"problemMatcher": []
		}
	]
}
