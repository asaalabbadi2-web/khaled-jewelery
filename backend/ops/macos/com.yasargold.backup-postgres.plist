<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.yasargold.backup-postgres</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd "$HOME/yasargold" &amp;&amp; ./backend/backup_postgres.sh</string>
  </array>

  <!-- PG_BIN is the bin DIRECTORY of the PostgreSQL client tools whose major
       version matches the server.  backup_postgres.sh refuses to create a
       backup when the majors differ, so this value is load-bearing, not a
       convenience: PATH on this machine resolves pg_dump to 14 while the
       server is 16.  Change it when the server major changes. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PG_BIN</key>
    <string>/opt/homebrew/opt/postgresql@16/bin</string>
  </dict>

  <!-- Daily, not hourly.  The retention policy this feeds is Daily/Weekly/Monthly,
       which an hourly cadence cannot express: hourly runs against a 14 DAY
       retention window keep about 336 archives.  Retention itself stays out of
       this file and out of backup_postgres.sh; BackupService will own it.
       02:30 and not 02:00 on purpose, because the in-app BackupScheduler
       defaults backup_auto_time to "02:00", and two engines dumping the same
       database in the same minute would contend.
       launchd runs a missed StartCalendarInterval as soon as the machine wakes,
       so a laptop asleep at 02:30 still gets its backup. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/yasargold-backup-postgres.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/yasargold-backup-postgres.err.log</string>
</dict>
</plist>
